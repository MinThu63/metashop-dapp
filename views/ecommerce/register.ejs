<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <title><%= pageTitle || 'User Registration' %></title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/web3.js/4.16.0/web3.min.js"></script>
  <style>
    .role-selector {
      display: flex;
      gap: 20px;
      margin: 20px 0;
    }
    .role-option {
      flex: 1;
      padding: 20px;
      border: 2px solid #ddd;
      border-radius: 8px;
      cursor: pointer;
      text-align: center;
      transition: all 0.3s ease;
    }
    .role-option:hover {
      border-color: #007bff;
      background-color: #f8f9fa;
    }
    .role-option.selected {
      border-color: #007bff;
      background-color: #e7f1ff;
    }
    .role-option input[type="radio"] {
      display: none;
    }
    .role-option h5 {
      margin-bottom: 10px;
      color: #333;
    }
    .role-option p {
      font-size: 0.9em;
      color: #666;
      margin: 0;
    }
    .metamask-section {
      margin-top: 20px;
      padding: 15px;
      background-color: #f8f9fa;
      border-radius: 8px;
      display: none;
    }
    .metamask-section.show {
      display: block;
    }
    .metamask-status {
      padding: 10px;
      border-radius: 4px;
      margin-top: 10px;
      display: none;
    }
    .metamask-status.show {
      display: block;
    }
    .metamask-status.success {
      background-color: #d4edda;
      color: #155724;
      border: 1px solid #c3e6cb;
    }
    .metamask-status.error {
      background-color: #f8d7da;
      color: #721c24;
      border: 1px solid #f5c6cb;
    }
  </style>
</head>
<body>
  <div class="container mt-5" style="max-width: 600px;">
    <h2><%= heading || 'Create Account' %></h2>
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    
    <form id="registerForm" method="POST" action="/register">
      <div class="mb-3">
        <label class="form-label">Username</label>
        <input class="form-control" name="name" required placeholder="Enter your username" />
      </div>
      
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" class="form-control" name="email" required placeholder="Enter your email" />
      </div>
      
      <div class="mb-3">
        <label class="form-label">Password</label>
        <input type="password" class="form-control" name="password" required placeholder="Enter your password" />
      </div>

      <input type="hidden" name="role" value="<%= defaultRole || 'buyer' %>" />

      <div class="metamask-section" id="metamaskSection">
        <label class="form-label d-block"><strong>Connect MetaMask</strong></label>
        <p style="font-size: 0.9em; color: #666; margin-bottom: 10px;">Connect your MetaMask wallet to complete registration</p>
        <button type="button" id="connectMetaMaskBtn" class="btn btn-warning w-100">
          🦊 Connect MetaMask
        </button>
        <button type="button" id="unlinkMetaMaskBtn" class="btn btn-outline-secondary w-100 mt-2" style="display: none;">
          Link to another account ?
        </button>
        <div id="metamaskStatus" class="metamask-status"></div>
        <input type="hidden" id="metamaskAddress" name="metamaskAddress" />
      </div>

      <button id="registerBtn" class="btn btn-primary w-100 mt-3" type="submit" disabled>
        Register
      </button>
      <a class="btn btn-link d-block text-center mt-2" href="/">Cancel</a>
    </form>
  </div>

  <script>
    const metamaskSection = document.getElementById('metamaskSection');
    const connectMetaMaskBtn = document.getElementById('connectMetaMaskBtn');
    const metamaskStatus = document.getElementById('metamaskStatus');
    const registerBtn = document.getElementById('registerBtn');
    const metamaskAddress = document.getElementById('metamaskAddress');
    const registerForm = document.getElementById('registerForm');
    const unlinkMetaMaskBtn = document.getElementById('unlinkMetaMaskBtn');

    // Show MetaMask section by default
    metamaskSection.classList.add('show');

    // MetaMask connection handler
    connectMetaMaskBtn.addEventListener('click', async (e) => {
      e.preventDefault();
      
      if (!window.ethereum) {
        showMetaMaskError('MetaMask is not installed. Please install it first.');
        return;
      }

      try {
        connectMetaMaskBtn.disabled = true;
        connectMetaMaskBtn.textContent = '⏳ Connecting...';
        
        const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
        const address = accounts[0];
        
        metamaskAddress.value = address;
        
        showMetaMaskSuccess(`Connected: ${address.substring(0, 6)}...${address.substring(address.length - 4)}`);
        connectMetaMaskBtn.textContent = '✅ Connected';
        connectMetaMaskBtn.disabled = true;
        unlinkMetaMaskBtn.style.display = 'block';
        
        updateRegisterButtonState();
      } catch (error) {
        showMetaMaskError('Failed to connect MetaMask: ' + (error.message || error));
        connectMetaMaskBtn.disabled = false;
        connectMetaMaskBtn.textContent = '🦊 Connect MetaMask';
        unlinkMetaMaskBtn.style.display = 'none';
      }
    });

    // Unlink MetaMask to allow re-connecting
    unlinkMetaMaskBtn.addEventListener('click', (e) => {
      e.preventDefault();
      metamaskAddress.value = '';
      connectMetaMaskBtn.disabled = false;
      connectMetaMaskBtn.textContent = '🦊 Connect MetaMask';
      metamaskStatus.classList.remove('show');
      unlinkMetaMaskBtn.style.display = 'none';
      updateRegisterButtonState();
    });

    function showMetaMaskSuccess(message) {
      metamaskStatus.textContent = message;
      metamaskStatus.className = 'metamask-status show success';
    }

    function showMetaMaskError(message) {
      metamaskStatus.textContent = message;
      metamaskStatus.className = 'metamask-status show error';
    }

    function updateRegisterButtonState() {
      const metamaskConnected = metamaskAddress.value.trim() !== '';
      
      if (metamaskConnected) {
        registerBtn.disabled = false;
      } else {
        registerBtn.disabled = true;
      }
    }

    // Handle form submission
    registerForm.addEventListener('submit', (e) => {
      const metamaskConnected = metamaskAddress.value.trim() !== '';
      
      if (!metamaskConnected) {
        e.preventDefault();
        alert('Please connect MetaMask to continue');
        return;
      }
    });
  </script>
</body>
</html>
