<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/styles.css">
    <title>Add Product Metadata - MetaShop Marketplace</title>
    <style>.form-container{max-width:600px;margin:2rem auto;padding:2rem;background:#fff;border-radius:12px}</style>
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
      <div class="container">
        <a class="navbar-brand d-flex align-items-center" href="/">
          <img src="/images/book.webp" width="45" height="45" style="margin-right: 12px; border-radius: 10px;"> 
          <div>
            <div>MetaShop</div>
            <small style="opacity: 0.8; font-size: 0.8rem;">Online Marketplace</small>
          </div>
        </a>
          
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
          <span class="navbar-toggler-icon"></span>
        </button>
          
        <div class="collapse navbar-collapse" id="navbarContent">
          <!-- Search Box -->
          <div class="mx-3 flex-grow-1 d-none d-lg-block">
            <div class="search-box">
              <div class="input-group">
                <input type="text" id="searchInput" class="form-control" placeholder="Search products...">
                <button class="btn btn-primary" id="searchBtn">
                  <i class="bi bi-search"></i>
                </button>
              </div>
            </div>
          </div>
              
          <!-- User Menu -->
          <div class="ms-auto d-flex align-items-center gap-3">
            <% if (typeof user !== 'undefined' && user) { %>
              <div class="user-info">
                <div class="user-avatar">
                  <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                </div>
                <div class="d-none d-md-block">
                  <div style="color: white; font-weight: 600; font-size: 0.95rem;">
                    <%= user.name || 'User' %>
                    <span class="role-badge <%= user.role === 'seller' ? 'seller-badge' : 'buyer-badge' %>">
                      <%= user.role || 'user' %>
                    </span>
                  </div>
                  <small style="color: #adb5bd; font-size: 0.75rem;">
                    <%= user.email || '' %>
                  </small>
                </div>
              </div>
                      
              <div class="dropdown">
                <button class="btn btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle"></i>
                  <% if (user.role === 'buyer' && cartItems && cartItems.length > 0) { %>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" 
                      style="font-size: 0.6rem; padding: 0.2rem 0.4rem;">
                      <%= cartItems.length %>
                      <span class="visually-hidden">items in cart</span>
                    </span>
                  <% } %>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li><a class="dropdown-item" href="/profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                  <% if (user.role === 'seller') { %>
                    <li><a class="dropdown-item" href="/sales-history"><i class="bi bi-cash-stack me-2"></i>Sales History</a></li>
                    <li><a class="dropdown-item" href="/seller-orders"><i class="bi bi-box-seam me-2"></i>Manage Orders</a></li>
                    <li><a class="dropdown-item" href="/dashboard"><i class="bi bi-speedometer2 me-2"></i>Seller Dashboard</a></li>
                  <% } else if (user.role === 'buyer') { %>
                    <li>
                      <a class="dropdown-item position-relative" href="/cart">
                        <i class="bi bi-cart me-2"></i>My Cart
                        <% if (cartItems && cartItems.length > 0) { %>
                          <span class="position-absolute top-50 end-0 translate-middle-y badge rounded-pill bg-danger me-2" 
                            style="font-size: 0.65rem; padding: 0.2rem 0.4rem;">
                            <%= cartItems.length %>
                          </span>
                        <% } %>
                      </a>
                    </li>
                    <li><a class="dropdown-item" href="/my-orders"><i class="bi bi-receipt me-2"></i>My Orders</a></li>
                  <% } %>
                  <% if (canSwitchRole) { %>
                    <li>
                      <form method="POST" action="/switch-role" class="px-3 py-1">
                        <input type="hidden" name="role" value="<%= switchRoleTarget %>" />
                        <button type="submit" class="dropdown-item">
                          <i class="bi bi-arrow-left-right me-2"></i>
                          Switch to <%= switchRoleTarget.charAt(0).toUpperCase() + switchRoleTarget.slice(1) %>
                        </button>
                      </form>
                    </li>
                  <% } %>
                  <li><hr class="dropdown-divider"></li>
                  <li><button class="dropdown-item" id="connectMetaMaskBtn"><i class="bi bi-wallet2 me-2"></i>Connect MetaMask</button></li>
                  <li><a class="dropdown-item text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                </ul>
              </div>
            <% } else { %>
              <div class="d-flex gap-2">
                <a class="btn btn-outline-light" href="/login">
                  <i class="bi bi-box-arrow-in-right"></i> Login
                </a>
                <a class="btn btn-primary" href="/register">
                  <i class="bi bi-person-plus"></i> Register
                </a>
                <button class="btn btn-light" id="connectMetaMaskBtn">
                  <i class="bi bi-wallet2"></i> Connect
                </button>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </nav>
  <div class="form-container">
    <h2 class="text-center">Add Product Metadata</h2>
    <h4 class="text-center">Product ID: <%= productId %></h4>
    <form action="/addMetadata" method="POST">
      <div class="form-group"><label>Key</label><input type="text" name="vaccine" class="form-control" required></div>
      <div class="form-group"><label>Value</label><input type="text" name="dateOfVaccine" class="form-control" required></div>
      <input type="hidden" id="productId" name="productId" value="<%= productId %>">
      <button type="submit" class="btn btn-primary mt-3">Add Metadata</button>
    </form>
  </div>
</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</html>
